# Database Configuration
MONGODB_URI=mongodb://localhost:27017/society-management

# Server Configuration
PORT=9007
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_SECRET_STRING=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# Email Configuration (Nodemailer / Gmail SMTP)
# For Gmail, generate an App Password from your Google Account:
# Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM="SMS Portal <your_email@gmail.com>"

# Client Configuration
CLIENT_URL=http://localhost:3258

# Server public URL (used in email links)
SERVER_URL=http://localhost:9007
